# ------------------------------------------------------------
# Pearls AQI — production configuration example
# ------------------------------------------------------------

APP_ENV=production
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Production Azure infrastructure
# ------------------------------------------------------------

AZURE_RESOURCE_GROUP=rg-pearls-aqi-prod

AZURE_CONTAINER_APP_ENVIRONMENT=cae-pearls-aqi-staging
AZURE_CONTAINER_APP_ENVIRONMENT_RESOURCE_GROUP=rg-pearls-aqi-staging

AZURE_MANAGED_IDENTITY_NAME=id-pearls-aqi-prod

AZURE_ACR_NAME=walpole
AZURE_ACR_SERVER=walpole.azurecr.io

AZURE_STORAGE_ACCOUNT=stpearlsaqiriyan
AZURE_STORAGE_CONTAINER=artifacts-prod


# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------

PEARLS_API_ENVIRONMENT=production
PEARLS_API_LOG_LEVEL=INFO

PEARLS_API_ARTIFACT_BACKEND=azure_blob
PEARLS_API_ARTIFACT_TYPE=aqi

PEARLS_API_AZURE_STORAGE_ACCOUNT=stpearlsaqiriyan
PEARLS_API_AZURE_STORAGE_CONTAINER=artifacts-prod

PEARLS_API_PHASE_6_BLOB_CACHE_DIRECTORY=/app/.cache/api/aqi/latest

PEARLS_API_ARTIFACT_CACHE_SECONDS=60

PEARLS_API_FORECAST_AGING_THRESHOLD_HOURS=7
PEARLS_API_FORECAST_STALENESS_THRESHOLD_HOURS=13


# Filled automatically after the dashboard is deployed.
PEARLS_API_ALLOWED_CORS_ORIGINS=[]


# ------------------------------------------------------------
# Streamlit
# ------------------------------------------------------------

DASHBOARD_ENVIRONMENT=production

# Filled after production API deployment.
FASTAPI_BASE_URL=

DASHBOARD_REQUEST_TIMEOUT_SECONDS=10
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_DEFAULT_TIMEZONE=Asia/Karachi


# ------------------------------------------------------------
# MLOps
# ------------------------------------------------------------

FEATURE_STORE_BACKEND=hopsworks
MODEL_REGISTRY_BACKEND=hopsworks

MLOPS_DRY_RUN=false

HOPSWORKS_PROJECT=
HOPSWORKS_HOST=

# Secret. Never commit its real value.
HOPSWORKS_API_KEY=


# ------------------------------------------------------------
# Production health monitoring
# ------------------------------------------------------------

AZURE_JOB_QUERY_BACKEND=arm

PRODUCTION_HEALTH_WEBHOOK_ENABLED=true

# Secret. Never commit its real value.
PRODUCTION_HEALTH_WEBHOOK_URL=

PRODUCTION_HEALTH_WEBHOOK_TIMEOUT_SECONDS=15

# Optional secret.
PRODUCTION_HEALTH_WEBHOOK_BEARER_TOKEN=