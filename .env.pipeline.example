# ---------------------------------------------------------------------------
# Pipeline runtime
# ---------------------------------------------------------------------------

APP_ENV=staging
APP_VERSION=replace-with-git-sha
SERVICE_ROLE=pipeline
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Azure deployment
# ---------------------------------------------------------------------------

AZURE_LOCATION=centralindia
AZURE_RESOURCE_GROUP=rg-pearls-aqi-staging
AZURE_CONTAINER_REGISTRY=walpole.azurecr.io

# Azure Container Apps scheduled job
FORECAST_JOB_NAME=job-pearls-aqi-forecast

# Azure Container Apps cron expressions use UTC.
# This runs every six hours: 00:00, 06:00, 12:00 and 18:00 UTC.
FORECAST_CRON_EXPRESSION=0 */6 * * *


# ---------------------------------------------------------------------------
# Durable artifact storage
# ---------------------------------------------------------------------------

ARTIFACT_BACKEND=azure_blob
LOCAL_ARTIFACT_ROOT=artifacts/repository

AZURE_STORAGE_ACCOUNT=stpearlsaqiriyan
AZURE_STORAGE_CONTAINER=artifacts-prod
AZURE_FEATURE_STORE_PREFIX=feature-store

# Optional future secret-management resource.
AZURE_KEY_VAULT_NAME=replace-after-creation


# ---------------------------------------------------------------------------
# Model and feature-store sources
# ---------------------------------------------------------------------------

MODEL_LOADING_MODE=HOPSWORKS_REGISTRY
FEATURE_STORE_BACKEND=hopsworks
# FEATURE_STORE_BACKEND=azure_blob
MODEL_REGISTRY_BACKEND=hopsworks

ALLOW_CACHED_REGISTRY_FALLBACK=true
ALLOW_LOCAL_MODEL_FALLBACK=true

# Azure Blob model-registry alternative.
AZURE_MODEL_REGISTRY_PREFIX=model-registry

# Future production switch:
# MODEL_REGISTRY_BACKEND=azure_blob
# MODEL_LOADING_MODE=AZURE_BLOB_REGISTRY

# ---------------------------------------------------------------------------
# Hopsworks credentials
# ---------------------------------------------------------------------------

HOPSWORKS_PROJECT=
HOPSWORKS_HOST=
HOPSWORKS_API_KEY=


# ---------------------------------------------------------------------------
# External data source
# ---------------------------------------------------------------------------

OPENAQ_API_KEY=


# ---------------------------------------------------------------------------
# Forecast operation
# ---------------------------------------------------------------------------

FORECAST_STALENESS_THRESHOLD_HOURS=6

# The scheduled forecast job performs inference and AQI publication only.
# Model retraining and automatic promotion remain disabled.
AUTOMATIC_RETRAINING_ENABLED=false
AUTOMATIC_MODEL_PROMOTION_ENABLED=false


# Hourly feature synchronization job
FEATURE_SYNC_JOB_NAME=job-pearls-aqi-features

# Azure Container Apps cron expressions use UTC.
FEATURE_SYNC_CRON_EXPRESSION=15 * * * *

# Hourly job behavior
MLOPS_DRY_RUN=false

# Incremental synchronization window
INCREMENTAL_OVERLAP_HOURS=30
INCREMENTAL_INITIAL_LOOKBACK_HOURS=168


# Daily retraining Azure Container Apps Job
AZURE_RETRAINING_JOB_NAME=job-pearls-aqi-retraining
AZURE_RETRAINING_CRON="30 3 * * *"
AZURE_RETRAINING_CPU=1.0
AZURE_RETRAINING_MEMORY=2Gi
AZURE_RETRAINING_TIMEOUT_SECONDS=3600
AZURE_RETRAINING_RETRY_LIMIT=1

# Runtime training packages are temporary inside each job execution.
RUNTIME_TRAINING_OUTPUT_DIR=/app/data/training/runtime


# Generic production-health webhook
PRODUCTION_HEALTH_WEBHOOK_ENABLED=false
PRODUCTION_HEALTH_WEBHOOK_URL=
PRODUCTION_HEALTH_WEBHOOK_TIMEOUT_SECONDS=15

# Optional endpoint authentication
PRODUCTION_HEALTH_WEBHOOK_BEARER_TOKEN=
