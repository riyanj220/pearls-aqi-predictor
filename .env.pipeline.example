APP_ENV=demo
APP_VERSION=replace-with-git-sha
SERVICE_ROLE=pipeline
LOG_LEVEL=INFO

AZURE_LOCATION=centralindia
AZURE_RESOURCE_GROUP=rg-pearls-aqi-demo
AZURE_CONTAINER_REGISTRY=walpole.azurecr.io

ARTIFACT_BACKEND=azure_blob
LOCAL_ARTIFACT_ROOT=artifacts/repository
AZURE_STORAGE_ACCOUNT=replace-after-creation
AZURE_STORAGE_CONTAINER=artifacts
AZURE_KEY_VAULT_NAME=replace-after-creation

MODEL_LOADING_MODE=HOPSWORKS_REGISTRY
FEATURE_STORE_BACKEND=hopsworks
MODEL_REGISTRY_BACKEND=hopsworks

HOPSWORKS_PROJECT=
HOPSWORKS_HOST=
HOPSWORKS_API_KEY=

OPENAQ_API_KEY=

FORECAST_STALENESS_THRESHOLD_HOURS=6

AUTOMATIC_RETRAINING_ENABLED=false
AUTOMATIC_MODEL_PROMOTION_ENABLED=false

ALLOW_CACHED_REGISTRY_FALLBACK=true
ALLOW_LOCAL_MODEL_FALLBACK=true