# OpenAQ
OPENAQ_API_KEY=


# FastAPI application
PEARLS_API_APPLICATION_NAME=Pearls AQI Predictor API
PEARLS_API_APPLICATION_VERSION=1.0.0
PEARLS_API_ENVIRONMENT=development

# FastAPI server
PEARLS_API_HOST=0.0.0.0
PEARLS_API_PORT=8000
PEARLS_API_API_PREFIX=/api/v1

# Browser clients
# Complex Pydantic settings must use valid JSON.
PEARLS_API_ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# Phase 6 latest artifacts
PEARLS_API_PHASE_6_LATEST_DIRECTORY=aqi/latest
PEARLS_API_PHASE_6_FORECAST_FILENAME=live_pm25_aqi_forecast.parquet
PEARLS_API_PHASE_6_ALERT_EPISODES_FILENAME=alert_episodes.json
PEARLS_API_PHASE_6_SUMMARY_FILENAME=aqi_forecast_summary.json
PEARLS_API_PHASE_6_METADATA_FILENAME=aqi_metadata.json
PEARLS_API_PHASE_6_VALIDATION_FILENAME=phase_6_validation_report.json

# Cache and forecast freshness
PEARLS_API_ARTIFACT_CACHE_SECONDS=60
PEARLS_API_FORECAST_AGING_THRESHOLD_HOURS=6
PEARLS_API_FORECAST_STALENESS_THRESHOLD_HOURS=12

# Logging
PEARLS_API_LOG_LEVEL=INFO


# Streamlit dashboard
# Local development URL. Docker Compose overrides this with http://api:8000/api/v1.
FASTAPI_BASE_URL=http://localhost:8000/api/v1
DASHBOARD_REQUEST_TIMEOUT_SECONDS=10
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_TITLE=Pearls AQI Predictor
DASHBOARD_DEFAULT_TIMEZONE=Asia/Karachi
DASHBOARD_ENVIRONMENT=development


# Phase 9 MLOps backends
FEATURE_STORE_BACKEND=local
MODEL_REGISTRY_BACKEND=local
MLOPS_DRY_RUN=true

# Required when either backend is set to "hopsworks".
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# Use the hostname only, without https:// or a URL path.
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PORT=443
HOPSWORKS_ENGINE=python
HOPSWORKS_HOSTNAME_VERIFICATION=true

# Hopsworks resource versions and model name
HOPSWORKS_FEATURE_GROUP_VERSION=1
HOPSWORKS_MODEL_NAME=pearls_aqi_pm25_forecaster

HOPSWORKS_PM25_FEATURE_GROUP_NAME=pm25_hourly_observations
HOPSWORKS_WEATHER_FEATURE_GROUP_NAME=weather_hourly_observations
HOPSWORKS_ENGINEERED_FEATURE_GROUP_NAME=pm25_hourly_features

HOPSWORKS_PM25_FEATURE_GROUP_VERSION=1
HOPSWORKS_WEATHER_FEATURE_GROUP_VERSION=1
HOPSWORKS_ENGINEERED_FEATURE_GROUP_VERSION=2

HOPSWORKS_FEATURE_VIEW_VERSION=2


FEATURE_PIPELINE_VERSION=phase_2_v1
SOURCE_DATA_VERSION=phase_1_v1

PHASE_1_CANONICAL_DATASET_PATH=data/processed/pearls_aqi_canonical_hourly.parquet
PHASE_2_TRAINING_DATASET_PATH=data/training/feature_dataset_full.parquet


HOPSWORKS_FEATURE_VIEW_NAME=pm25_reference_features
HOPSWORKS_TRAINING_DATASET_NAME=pm25_72h_training_dataset
HOPSWORKS_TRAINING_DATASET_VERSION=1
TRAINING_DATASET_FLOAT_TOLERANCE=0.00000001


HOPSWORKS_INITIAL_MODEL_VERSION=1
HOPSWORKS_PRODUCTION_MODEL_VERSION=1
MODEL_CACHE_DIRECTORY=models/registry_cache


# Phase 9G inference model source (LOCAL_ARTIFACT/HOPSWORKS_REGISTRY)
MODEL_LOADING_MODE=LOCAL_ARTIFACT
ALLOW_CACHED_REGISTRY_FALLBACK=true
ALLOW_LOCAL_MODEL_FALLBACK=true