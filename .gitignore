.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env

data/raw/*
data/processed/*
data/reports/*

# Ignore generated model artifacts by default
models/*

# Keep the models directory
!models/.gitkeep

# Keep the production runtime fallback artifacts
!models/best_model.joblib
!models/model_metadata.json
!models/model_feature_columns.json

# Keep generated subdirectories ignored
models/artifacts/

models/registry_package/*
!models/registry_package/.gitkeep

models/registry_cache/*
!models/registry_cache/.gitkeep

models/candidates/*
!models/candidates/.gitkeep

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
data/training/*
!data/training/.gitkeep

reports/*
!reports/.gitkeep

models/artifacts/

*.egg-info/
raw datasets
processed datasets


# Generated explainability outputs
explainability/*
!explainability/.gitkeep

# Generated error-analysis outputs
error_analysis/*
!error_analysis/.gitkeep

# Generated figures
figures/*
!figures/.gitkeep

# Generated live inference runs
inference/runs/*
!inference/runs/.gitkeep

# Generated AQI and alert artifacts
aqi/latest/*
!aqi/latest/.gitkeep

aqi/runs/*
!aqi/runs/.gitkeep

# Generated durable local artifact repository
artifacts/repository/*
!artifacts/repository/.gitkeep

# API materialized Blob cache
.cache/


# Local production-health persistence validation
artifacts/health-validation/
artifacts/health-webhook-validation/
