APP_ENV=demo
APP_VERSION=replace-with-git-sha
SERVICE_ROLE=api
LOG_LEVEL=INFO

AZURE_LOCATION=centralindia
AZURE_RESOURCE_GROUP=rg-pearls-aqi-demo
AZURE_CONTAINER_REGISTRY=walpole.azurecr.io

ARTIFACT_BACKEND=azure_blob
LOCAL_ARTIFACT_ROOT=.
AZURE_STORAGE_ACCOUNT=replace-after-creation
AZURE_STORAGE_CONTAINER=artifacts
AZURE_KEY_VAULT_NAME=replace-after-creation

ALLOWED_CORS_ORIGINS=https://replace-with-streamlit-url
FORECAST_STALENESS_THRESHOLD_HOURS=6

MODEL_LOADING_MODE=LOCAL_ARTIFACT
FEATURE_STORE_BACKEND=local
MODEL_REGISTRY_BACKEND=local

AUTOMATIC_RETRAINING_ENABLED=false
AUTOMATIC_MODEL_PROMOTION_ENABLED=false


# Artifact source
# local: read PEARLS_API_PHASE_6_LATEST_DIRECTORY directly
# azure_blob: materialize the latest durable AQI package from Blob Storage
PEARLS_API_ARTIFACT_BACKEND=local
PEARLS_API_ARTIFACT_TYPE=aqi

# Azure Blob artifact source
PEARLS_API_AZURE_STORAGE_ACCOUNT=
PEARLS_API_AZURE_STORAGE_CONTAINER=artifacts

# Writable local cache used only when the backend is azure_blob
PEARLS_API_PHASE_6_BLOB_CACHE_DIRECTORY=.cache/api/aqi/latest