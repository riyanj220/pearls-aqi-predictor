# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------

PEARLS_API_APPLICATION_NAME=Pearls AQI Predictor API
PEARLS_API_APPLICATION_VERSION=1.0.0
PEARLS_API_ENVIRONMENT=staging
PEARLS_API_LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

PEARLS_API_HOST=0.0.0.0
PEARLS_API_PORT=8000
PEARLS_API_API_PREFIX=/api/v1


# ---------------------------------------------------------------------------
# Artifact source
# ---------------------------------------------------------------------------

# local:
# Read the bundled files directly from /app/aqi/latest.
#
# azure_blob:
# Download the latest approved AQI package from Azure Blob Storage
# into the writable container cache.
PEARLS_API_ARTIFACT_BACKEND=azure_blob

# Blob artifact family/prefix, for example: aqi/latest/pointer.json
PEARLS_API_ARTIFACT_TYPE=aqi


# ---------------------------------------------------------------------------
# Azure Blob Storage
# ---------------------------------------------------------------------------

PEARLS_API_AZURE_STORAGE_ACCOUNT=replace-with-storage-account
PEARLS_API_AZURE_STORAGE_CONTAINER=artifacts


# ---------------------------------------------------------------------------
# Artifact directories
# ---------------------------------------------------------------------------

# Writable temporary cache used when ARTIFACT_BACKEND=azure_blob.
PEARLS_API_PHASE_6_BLOB_CACHE_DIRECTORY=/app/.cache/api/aqi/latest

# Bundled fallback directory used when ARTIFACT_BACKEND=local.
PEARLS_API_PHASE_6_LATEST_DIRECTORY=/app/aqi/latest


# ---------------------------------------------------------------------------
# Phase 6 artifact filenames
# ---------------------------------------------------------------------------

PEARLS_API_PHASE_6_FORECAST_FILENAME=live_pm25_aqi_forecast.parquet
PEARLS_API_PHASE_6_ALERT_EPISODES_FILENAME=alert_episodes.json
PEARLS_API_PHASE_6_SUMMARY_FILENAME=aqi_forecast_summary.json
PEARLS_API_PHASE_6_METADATA_FILENAME=aqi_metadata.json
PEARLS_API_PHASE_6_VALIDATION_FILENAME=phase_6_validation_report.json


# ---------------------------------------------------------------------------
# Cache and freshness
# ---------------------------------------------------------------------------

# Number of seconds the API may reuse the currently loaded artifact bundle
# before checking Azure Blob Storage again.
PEARLS_API_ARTIFACT_CACHE_SECONDS=60

# Temporary staging/demo thresholds.
# Restore stricter values such as 6 and 12 once the scheduled pipeline runs.
PEARLS_API_FORECAST_AGING_THRESHOLD_HOURS=48
PEARLS_API_FORECAST_STALENESS_THRESHOLD_HOURS=168


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Must be a JSON array because the setting is a tuple/list.
PEARLS_API_ALLOWED_CORS_ORIGINS=["https://replace-with-dashboard-fqdn"]